{
  "schema_version": 1,
  "chunk_strategies": ["page", "fixed", "boundary"],
  "chunk_size": 700,
  "chunk_overlap": 120,
  "embedding_models": [
    "sentence-transformers/all-MiniLM-L6-v2",
    "BAAI/bge-small-en-v1.5",
    "intfloat/e5-small-v2"
  ],
  "development_top_k": 5,
  "evaluation_candidate_k": 50,
  "test_top_k_values": [1, 3, 5, 10],
  "latency_repetitions": 5,
  "hybrid_rrf_constant": 60,
  "selection_order": ["recall_at_k", "mrr", "precision_at_k", "latency_ms_p95"]
}
